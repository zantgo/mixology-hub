# MixologyHub Environment Configuration
# Copy this file to .env in the root directory and fill in your actual values

# --- Database Configuration (Matches docker-compose.yml) ---
DB_HOST=postgres
DB_PORT=5432
DB_USER=admin
DB_PASSWORD=secretpassword
DB_NAME=mixology_hub

# --- Redis Configuration ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- AI Provider Configuration (Plug-and-Play) ---
# Example using DeepSeek (Compatible with OpenAI SDKs/Formats)
AI_API_URL=https://api.deepseek.com/v1/chat/completions
AI_API_KEY=your_deepseek_api_key_here
AI_MODEL=deepseek-chat

# AI quota and safety limits (override defaults)
# AI_MAX_RECIPES_PER_DAY=50
# AI_MAX_INGREDIENTS_PER_RECIPE=15
# AI_BANNED_INGREDIENTS=methanol,ethanol (pure),industrial alcohol,denatured alcohol,toxic berries,poisonous plants,household chemicals,bleach,ammonia,gasoline,paint thinner,antifreeze
# AI_BANNED_THEMES=drugs,illegal substances,explicit,offensive,dangerous challenges,harmful,toxic,poison

# AI Tool Audit sampling rate for read operations (0-100, default 10)
# Read operations are sampled at this percentage. Write operations are always logged.
# AI_AUDIT_READ_SAMPLE_RATE=10

# Alternative OpenAI configuration:
# AI_API_URL=https://api.openai.com/v1/chat/completions
# AI_API_KEY=your_openai_api_key_here
# AI_MODEL=gpt-4o-mini

# Alternative Anthropic configuration:
# AI_API_URL=https://api.anthropic.com/v1/messages
# AI_API_KEY=your_anthropic_api_key_here
# AI_MODEL=claude-3-5-sonnet-20241022

# --- Application Configuration ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Rate Limiting ---
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# --- CORS ---
# CORS_ORIGIN=https://mixologyhub.com,https://app.mixologyhub.com

# --- Authentication Configuration (MVP Phase) ---
JWT_SECRET=super_secret_access_key_change_me_in_prod
JWT_REFRESH_SECRET=super_secret_refresh_key_change_me_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
ENABLE_MOCK_AUTH=true  # Default true for development
MOCK_USER_EMAIL=mock@test.com

# --- Email Configuration (SMTP for password reset + verification) ---
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=your_password
# SMTP_FROM_NAME=MixologyHub
# SMTP_FROM_ADDRESS=noreply@mixologyhub.com
# APP_BASE_URL=http://localhost:4200

# --- External API Configuration ---
# TheCocktailDB API (public, no key required)
THE_COCKTAIL_DB_BASE_URL=https://www.thecocktaildb.com/api/json/v1/1

# --- GDPR Data Retention Configuration (in days) ---
GDPR_USER_INACTIVE_THRESHOLD=730    # Delete users inactive for 2 years
GDPR_USER_ANONYMIZE_THRESHOLD=365   # Anonymize users inactive for 1 year
GDPR_INVENTORY_THRESHOLD=180        # Delete inventory history older than 6 months
GDPR_AI_DATA_THRESHOLD=90           # Delete AI generated recipes older than 3 months
GDPR_LOG_THRESHOLD=30               # Delete logs older than 1 month